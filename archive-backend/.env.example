# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed.

# ── Database ───────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/archive_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=archive
SPRING_DATASOURCE_PASSWORD=archive_pass

# ── JWT (generate with: openssl rand -hex 64) ────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex_string_here_do_not_use_in_production

# ── MinIO / S3 ─────────────────────────────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=archive-files
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000
